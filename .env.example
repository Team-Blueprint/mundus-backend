PROJECT_NAME="Mundus Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mundus_db"

# JWT Auth Secret
SECRET_KEY="CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_MUNDUS_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Anti-fraud Geofence radius (meters)
GEOFENCE_RADIUS_METERS=100.0
OVERDUE_THRESHOLD_DAYS=10

# Frontend Deep-linking
FRONTEND_ORIGIN="http://localhost:5173"

# Brevo Email Configuration
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="noreply@mundus.org"
BREVO_SENDER_NAME="Mundus Waste Tracking"

# Optional SMTP Relay
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# FCM Web Push
FCM_SERVER_KEY=""


